KAKUREGA_APP_NAME=Kakurega API
KAKUREGA_ENVIRONMENT=development
KAKUREGA_DEBUG=true
KAKUREGA_API_V1_PREFIX=/api/v1
KAKUREGA_DATABASE_URL=postgresql+psycopg://kakurega:kakurega_password@localhost:5432/kakurega
KAKUREGA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Without a key, Google Books uses a shared anonymous project that is
# frequently rate-limited. Create a key with the Books API enabled in Google
# Cloud Console. Never commit the value.
KAKUREGA_GOOGLE_BOOKS_API_KEY=
