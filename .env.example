POSTGRES_DB=kakurega
POSTGRES_USER=kakurega
POSTGRES_PASSWORD=kakurega_password
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

KAKUREGA_APP_NAME=Kakurega API
KAKUREGA_ENVIRONMENT=development
KAKUREGA_DEBUG=true
KAKUREGA_API_V1_PREFIX=/api/v1
KAKUREGA_DATABASE_URL=postgresql+psycopg://kakurega:kakurega_password@postgres:5432/kakurega
KAKUREGA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://backend:8000
